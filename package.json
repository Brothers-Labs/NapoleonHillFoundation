{
  "name": "napoleon-hill-foundation",
  "version": "0.1.1",
  "description": "Experiência digital institucional da The Napoleon Hill Foundation Brasil.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "seo:generate": "node scripts/generate-seo-files.mts",
    "prebuild": "npm run seo:generate",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"scripts/**/*.mts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"scripts/**/*.mts\"",
    "preview": "npx --yes http-server@14 dist/napoleon-hill-foundation/browser -p 4300 -c-1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.26",
    "gsap": "^3.15.0",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.17.19",
    "@types/three": "^0.186.0",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
